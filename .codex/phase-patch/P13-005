+		ShortMessage: []byte("x"),
+		Optional:     []protocol.OptionalParameter{{Tag: protocol.TLVTagMessagePayload, Value: []byte("y")}},
+	}, registry)
+	if !errors.Is(err, ErrConflictingMessageData) {
